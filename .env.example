# .env.example — compreface-fe. Salin ke .env lalu isi nilai yang ditandai WAJIB. (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/base. JANGAN isi nilai asli di file ini.
# host:port admin (tanpa skema)
ADMIN_UPSTREAM=compreface-admin:8080
# host:port api
API_UPSTREAM=compreface-api:8080
# host:port core (hanya untuk `GET /core/status`)
CORE_UPSTREAM=compreface-core:3000
# kosong = otomatis dari `/etc/resolv.conf`
NGINX_RESOLVER=
# TTL cache DNS nginx
NGINX_RESOLVER_VALID=10s
# lengkapi nama pendek dengan domain search pertama (k8s)
NGINX_UPSTREAM_AUTO_FQDN=true
# batas upload
CLIENT_MAX_BODY_SIZE=10M
PROXY_READ_TIMEOUT=60000ms
PROXY_CONNECT_TIMEOUT=10000ms
TZ=Asia/Jakarta
